# Security headers for Cloudflare (Pages or Workers static assets).
# Palaka is fully local: no server, no third-party scripts, no CDN calls.
# So everything is locked to this site; blob: and data: are allowed only
# where the app itself creates them (pasted images, recordings, exports).
#
# - img/media blob: data:  pasted images, export previews, recording preview
# - style-src unsafe-inline  React sets inline styles (board sizing, swatches)
# - connect-src self data: blob:  export reads its own fonts and images
# - display-capture + microphone = self  board recording (Element Capture + mic)
# - camera=(self) for in-board facecam bubble
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: display-capture=(self), microphone=(self), camera=(self), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Fonts and hashed build files never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
